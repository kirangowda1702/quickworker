# QuickWorker - Firebase Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials from the Firebase Console.

# Firebase API Key
VITE_FIREBASE_API_KEY=your_api_key_here

# Firebase Domains
VITE_FIREBASE_AUTH_DOMAIN=quickworker-54496.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quickworker-54496
VITE_FIREBASE_STORAGE_BUCKET=quickworker-54496.firebasestorage.app

# Firebase Apps Meta
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
